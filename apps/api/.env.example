# Runtime role: subject to RLS
DATABASE_URL=postgres://hestia_app:hestia_app@localhost:5433/hestia
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
