{
  "name": "hestia",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "bun run --filter @workspace/db db:generate",
    "db:migrate": "bun run --filter @workspace/db db:migrate",
    "db:seed": "bun run --filter @workspace/db db:seed",
    "db:studio": "bun run --filter @workspace/db db:studio"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.12",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
